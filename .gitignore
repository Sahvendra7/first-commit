# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo
apps/web/dist/

# CDK
cdk.out/
infra/cdk/cdk.context.json
.cdk.staging/

# env / secrets — no secret ever belongs in this repo (architecture.md §10.3)
.env
.env.*
!.env.example
*.pem

# eval golden set: real photographs of a real home, and answer keys that
# describe its defects. Never commit these. The format documentation is not
# itself golden-set data, so it is the one exception.
# (a directory-level ignore would make the negation below unreachable)
eval/golden-set/*
!eval/golden-set/README.md

# local tooling
.DS_Store
coverage/
.vitest/
.claude/settings.local.json
