# Handover web — example configuration.
#
# Copy to `.env.local` (gitignored) and fill in the values for your stage.
# None of these are secrets: a Cognito user pool id and public app client id
# ship inside every browser bundle. They live here because they differ per
# stage, not because they are sensitive.
#
# NEVER put in this file or any committed file: an AWS account id, an access
# key, a Cognito client secret, or a token. The web app client is created
# without a secret on purpose — a public SPA cannot hold one.

# API Gateway HTTP API endpoint for the stage. No trailing slash.
VITE_API_BASE_URL=https://REPLACE-ME.execute-api.ap-south-1.amazonaws.com

# Cognito user pool that fronts the API (CDK output `HandoverDevAuth.UserPoolId`).
VITE_COGNITO_USER_POOL_ID=ap-south-1_REPLACEME

# Public app client id (CDK output `HandoverDevAuth.UserPoolClientId`).
VITE_COGNITO_CLIENT_ID=REPLACEMEREPLACEMEREPLACEME

# Optional. Derived from the user pool id when omitted.
# VITE_AWS_REGION=ap-south-1
